CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Flashing and the console go over the native USB (through the CH334P hub on the cart)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
# 1 ms FreeRTOS tick: the power manager runs every 1 ms
CONFIG_FREERTOS_HZ=1000
# RF calibration: partial with NVS data; a full calibration only ever happens on USB (main.c refuses WiFi otherwise)
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=y
CONFIG_ESP_PHY_RF_CAL_PARTIAL=y
# A5: frames <= ~2.5 ms, so no A-MPDU / A-MSDU aggregation on TX
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMSDU_TX_ENABLED=n
# PARK = auto light-sleep (only possible while the SPI slave is freed: it holds an APB lock)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# HTTPS for GET / BTC / OTA
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_LWIP_IPV6=n
# TIME answers within the 8 s job deadline: no random SNTP start delay (default up to 5 s)
CONFIG_LWIP_SNTP_STARTUP_DELAY=n
# OTA: a new image that does not reach "link up" is rolled back at the next boot
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Boot energy: on a weak console the reservoir holds ~6.75 mJ above power-good and the ESP must reach app_main within
# it (S1 sweep 2026-10-14: <= ~100 ms at 20 mA works on a 2.5 ohm console, 300 ms at 25 mA boot-loops). So: no app
# hash check on power-on (OTA rollback still guards bad images) and a quiet bootloader. Measure on the XIAO (a7_cal).
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
